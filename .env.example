# Agentic Calendar - Environment Configuration
# Copy this file to .env and fill in your API keys

# OpenAI API Key (required if using OpenAI)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API Key (required if using Anthropic/Claude)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Note: You only need ONE of the above keys configured.
# The app will use whichever provider has a valid key.
